generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN_DIEL
  GESTOR_CLIENTE
  GERENTE_LOJA
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  SEM_DADOS
}

enum EnvironmentStatus {
  CONFORTAVEL
  FORA_FAIXA
  SEM_DADOS
}

model Client {
  id        String   @id
  nome      String
  segmento  String
  lojas     Store[]
  usuarios  User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Store {
  id                   String                @id
  clientId             String
  nome                 String
  tipo                 String
  cidade               String
  uf                   String
  latitude             Float
  longitude            Float
  fusoHorario          String
  horarioFuncionamento Json
  client               Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ambientes            Environment[]
  externalTemperatures ExternalTemperature[]
  userStoreAccess      UserStoreAccess[]
  ingestionEvents      IngestionEvent[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([clientId])
}

model ExternalTemperature {
  id           String   @id @default(cuid())
  storeId      String
  timestampUtc DateTime
  temperature  Float
  source       String   @default("open-meteo")
  createdAt    DateTime @default(now())
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, timestampUtc])
  @@index([storeId, timestampUtc(sort: Desc)])
}

model Environment {
  id                   String             @id
  storeId              String
  nome                 String
  faixaConfortoMin     Float
  faixaConfortoMax     Float
  horarioFuncionamento Json
  devId                String             @unique
  status               EnvironmentStatus  @default(SEM_DADOS)
  store                Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  device               Device?
  readings             TelemetryReading[]
  comfortMetrics       ComfortMetric[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([storeId])
}

model Device {
  id            String             @id
  environmentId String             @unique
  lastPacketAt  DateTime?
  status        DeviceStatus       @default(SEM_DADOS)
  environment   Environment        @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  readings      TelemetryReading[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status])
}

model User {
  id        String            @id
  nome      String
  email     String            @unique
  senha     String
  role      UserRole
  clientId  String?
  client    Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  stores    UserStoreAccess[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([clientId])
}

model UserStoreAccess {
  id      String @id @default(cuid())
  userId  String
  storeId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([userId])
  @@index([storeId])
}

model RawTelemetryPacket {
  id           String   @id @default(cuid())
  devId        String
  timestamp    DateTime
  gmt          Int
  samplingTime Int
  temperatures Json
  savedData    Boolean  @default(false)
  sourceLine   Int
  sourceKey    String   @unique
  createdAt    DateTime @default(now())

  @@index([devId, timestamp(sort: Desc)])
}

model TelemetryReading {
  id              String      @id @default(cuid())
  devId           String?
  environmentId   String
  packetTimestamp DateTime
  packetGmt       Int
  samplingTime    Int
  timestampUtc    DateTime
  temperature     Float
  inComfort       Boolean
  inWorkingHours  Boolean
  isLatePacket    Boolean     @default(false)
  isSpurious      Boolean     @default(false)
  sourcePacketId  String?
  device          Device?     @relation(fields: [devId], references: [id], onDelete: SetNull)
  environment     Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())

  @@unique([devId, timestampUtc])
  @@index([environmentId, timestampUtc(sort: Desc)])
  @@index([environmentId, isSpurious, timestampUtc(sort: Desc)])
  @@index([devId, timestampUtc(sort: Desc)])
}

model ComfortMetric {
  id                String      @id @default(cuid())
  environmentId     String
  periodStart       DateTime
  periodEnd         DateTime
  comfortPercent    Float
  monitoredSeconds  Int
  comfortSeconds    Int
  outOfRangeSeconds Int
  missingSeconds    Int
  createdAt         DateTime    @default(now())
  environment       Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([environmentId, periodStart, periodEnd])
}

model IngestionState {
  id               String   @id
  referenceTimeUtc DateTime
  updatedAt        DateTime @updatedAt
}


model IngestionEvent {
  id               BigInt   @id @default(autoincrement())
  storeId          String
  referenceTimeUtc DateTime
  createdAt        DateTime @default(now())
  processedAt      DateTime?
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([processedAt, id])
  @@index([storeId, createdAt])
}
