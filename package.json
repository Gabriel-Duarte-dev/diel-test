{
  "name": "diel-celsius360-challenge",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -ws --if-present",
    "dev": "npm run dev -ws --if-present",
    "lint": "npm run typecheck -ws --if-present",
    "test": "npm run test -ws --if-present",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:seed:scale": "npm run db:seed:scale -w apps/api",
    "typecheck": "npm run typecheck -ws --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
